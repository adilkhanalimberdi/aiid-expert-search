# Скопируй в .env: Copy-Item .env.example .env
# Секретов здесь нет, решение работает офлайн.

# Модель эмбеддингов (путь относительно backend/)
MODEL_PATH=models/bge-m3
# Для e5-моделей: "query: " и "passage: ". Для bge-m3 пусто.
QUERY_PREFIX=
PASSAGE_PREFIX=

# Не ходить в интернет за моделью
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Данные (относительно backend/)
EXPERTS_CSV=data/experts.csv
EVAL_QUERIES=data/eval_queries.json

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Отдавать собранный фронт с бэкенда (один порт, без Docker): WEB_DIST=../web/dist
WEB_DIST=

# Фронт (Vite читает только переменные с префиксом VITE_). Пусто: API на том же адресе, что страница.
# Задавай, только если API на другом хосте, и не localhost: иначе на проде браузер пойдёт к себе.
VITE_API_URL=
